{
  "functions": {
    "api/search.js": {
      "maxDuration": 60,
      "regions": [
        "cdg1"
      ]
    },
    "api/historical.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
